# Akuko environment configuration
#
# Copy this file to `.env` and fill in real values, OR pass the same keys via
# --dart-define at build/run time (dart-define takes precedence over .env).
#
#   flutter run \
#     --dart-define=AKUKO_API_BASE_URL=https://books.ikikearts.com/wp-json/akuko/v1/
#
# The .env file itself is git-ignored. Never commit real keys.

# WordPress Akuko Mobile API base URL
AKUKO_API_BASE_URL=https://books.ikikearts.com/wp-json/akuko/v1/

# ---------------------------------------------------------------------------
# Paystack (client-side, PUBLIC values only)
# ---------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key

PAYSTACK_CURRENCY=NGN

PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_YEARLY=

# ---------------------------------------------------------------------------
# AI (optional)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# Google Gemini — contextual dictionary in the reader
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Admin web uses separate env in akuko/admin/.env.example
