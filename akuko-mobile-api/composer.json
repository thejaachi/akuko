{
    "name": "ikikearts/akuko-mobile-api",
    "description": "BFF REST API for Akuko Flutter mobile app",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Akuko\\MobileApi\\": "includes/"
        },
        "classmap": [
            "includes/",
            "admin/",
            "database/migrations/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Akuko\\MobileApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
